{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>{d+=c});process.stdin.on('end',()=>{try{const p=JSON.parse(d).tool_input?.file_path;if(p&&/\\.(jsx?|css|json|md)$/.test(p))require('child_process').spawnSync('npx',['prettier','--write',p],{stdio:'inherit',shell:true})}catch{}});\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>{d+=c});process.stdin.on('end',()=>{try{if(JSON.parse(d).stop_hook_active)process.exit(0)}catch{}const r=require('child_process').spawnSync('npm',['run','lint'],{stdio:'inherit',shell:true});process.exit(r.status===0?0:2)});\""
          }
        ]
      }
    ]
  }
}
